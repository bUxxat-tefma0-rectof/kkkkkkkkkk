# ============================================
# 🐕 DOGUINHA STORE BOT - CONFIGURAÇÕES
# ============================================

# Nome do Bot
BOT_NAME=Doguinha Store

# Número do Administrador (com DDD - apenas números)
ADMIN_NUMBER=5544999943206

# Telegram do Suporte (com @)
SUPPORT_TELEGRAM=@doguinhastore

# ============================================
# MERCADO PAGO (API PIX)
# ============================================
# Pegue em: https://www.mercadopago.com.br/developers/panel
# Vá em: Credenciais > Access Token (produção ou teste)
# COLE APENAS O ACCESS TOKEN ABAIXO:
MP_ACCESS_TOKEN=APP_USR-seu-token-aqui

# ============================================
# COMISSÕES
# ============================================
COMMISSION_PERCENTAGE=10

# ============================================
# PIX
# ============================================
PIX_EXPIRATION=30

# ============================================
# BANCO DE DADOS
# ============================================
DB_PATH=./database/store.db
